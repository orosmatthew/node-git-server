{
	"name": "node-git-server",
	"version": "1.0.0",
	"description": "🎡 A configurable git server written in Node.js",
	"author": "Gabriel J. Csapo <gabecsapo@gmail.com>",
	"contributors": [
		{
			"name": "echopoint",
